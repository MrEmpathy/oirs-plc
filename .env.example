# Plantilla de configuración. scripts/preparar_entorno.sh crea el .env real con valores aleatorios.
# NUNCA versionar el .env ni escribir secretos reales aquí (SC-05).

# --- Django ---
DJANGO_SECRET_KEY=cambiar-por-valor-aleatorio-de-64-caracteres
DJANGO_DEBUG=0
DJANGO_SECURE=1                                   # cookies Secure, HSTS y redirección a HTTPS
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,nginx    # producción: oirs.salud.padrelascasas.cl
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost:8443
DJANGO_CONFIAR_PROXY=1                            # usar X-Real-IP de Nginx como IP de origen
OIRS_HTTPS_PUERTO_PUBLICO=8443
OIRS_HTTP_PUERTO_PUBLICO=8081
WP_PUERTO_PUBLICO=8080
ENCUESTA_PUERTO_PUBLICO=8082                      # encuesta de demostración sin WordPress
COMPOSE_PROFILES=                                 # «encuesta» = levantar la encuesta de demostración en Nginx
# OIRS_NOMBRE_PUBLICO=ls.local                    # lo fija scripts/configurar_acceso_red.sh

# --- PostgreSQL: superusuario del contenedor, propietario (migraciones) y aplicación (mínimo privilegio) ---
PG_SUPERUSER_PASSWORD=
PG_OWNER_PASSWORD=
PG_DB=oirs_plc
PG_USER=oirs_app
PG_PASSWORD=
PG_HOST=postgres
PG_SSLMODE=disable                                # red interna de Docker; con BD externa usar require

# --- MongoDB (base documental) ---
MONGO_ROOT_PASSWORD=
MONGO_APP_PASSWORD=
MONGO_URI=mongodb://oirs_app:CLAVE@mongo:27017/?authSource=admin
MONGO_DB=oirs_plc_docs

# --- Caché ---
REDIS_URL=redis://redis:6379/0

# --- Integración WordPress -> API (el mismo valor va en wp-config.php como OIRS_HMAC_SECRET) ---
WP_HMAC_SECRET=
WP_DB_PASSWORD=

# --- Datos de demostración y operación ---
CLAVE_DEMO=                                       # contraseña inicial de los usuarios de demostración
# RESPALDO_CLAVE=                                 # la crea scripts/respaldo.sh en el primer respaldo
# RETENCION_DATOS_PERSONALES_DIAS=1825            # provisorio: pendiente de confirmar con el DSM
# RETENCION_BITACORA_DIAS=730
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend   # producción: SMTP institucional
